<UserControl x:Class="TournamentTool.App.Views.SceneManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
             xmlns:selectable="clr-namespace:TournamentTool.ViewModels.Selectable;assembly=TournamentTool.ViewModels"
             xmlns:components="clr-namespace:TournamentTool.App.Components"
             xmlns:behaviors="clr-namespace:TournamentTool.App.Components.Behaviors"
             xmlns:controls="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:obs="clr-namespace:TournamentTool.ViewModels.Obs;assembly=TournamentTool.ViewModels"
             xmlns:common="clr-namespace:ObsWebSocket.Core.Protocol.Common;assembly=ObsWebSocket.Core"
             xmlns:items="clr-namespace:TournamentTool.ViewModels.Obs.Items;assembly=TournamentTool.ViewModels"
             xmlns:domain="clr-namespace:TournamentTool.Domain.Obs;assembly=TournamentTool.Domain"
             xmlns:buttons="clr-namespace:TournamentTool.App.Components.Buttons"
             xmlns:vm="clr-namespace:TournamentTool.ViewModels.UI;assembly=TournamentTool.ViewModels"
             xmlns:converters="clr-namespace:TournamentTool.App.Converters"
             d:DataContext="{d:DesignInstance Type=selectable:SceneManagementViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="601"
             d:DesignWidth="1082"
             Background="#1E1E1E">
    <UserControl.Resources>
        <converters:TypeEqualsConverter x:Key="TypeEqualsConverter" />

        <ContextMenu x:Key="SceneItemsContextMenu">
            <MenuItem Header="Edit"
                      Command="{Binding DataContext.EditSceneItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding Content}" />
        </ContextMenu>

        <ContextMenu x:Key="GroupItemContextMenu">
            <!-- FUTURE -->
            
            <!--<MenuItem Header="Mass edit"
                      Command="{Binding ., RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding Content}" />-->
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <i:Interaction.Behaviors>
                    <behaviors:ActualSizeBehavior Dimension="{Binding SceneDimension, Mode=OneWayToSource, BindsDirectlyToSource=True}" />
                </i:Interaction.Behaviors>

                <components:SceneCanvas DataContext="{Binding SceneEditor.MainSceneViewModel}" />
            </Grid>

            <Grid Grid.Row="1">
                <!--
                <StackPanel Orientation="Vertical"
                            Margin="0 0 0 5">
                    <TextBlock Text="Display name in pov"
                               HorizontalAlignment="Left"
