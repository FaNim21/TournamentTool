                -->

                <!-- TUTAJ JAKIES GUZIKI? -->

                <buttons:ButtonNormal ContentText="Something"
                                      Width="150"
                                      Height="40"
                                      FontSize="25"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left"
                                      OnCommand="{Binding .}"
                                      Margin="20" />
            </Grid>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#000D14"
                        BorderThickness="0 0 0 3"
                        Background="Transparent">
                    <!-- TUTAJ SCENY DO ZMIANY -->

                    <ListBox Background="Transparent"
                             VerticalAlignment="Top"
                             HorizontalContentAlignment="Stretch"
                             SelectedItem="{Binding SelectedScene, Mode=TwoWay}"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             VirtualizingStackPanel.ScrollUnit="Pixel">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SceneEditor.SelectedSceneChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <i:Interaction.Behaviors>
                            <behaviors:CollectionViewBehavior Source="{Binding Scenes}"
                                                              RefreshTrigger="{Binding SceneRefreshTrigger}" />
                        </i:Interaction.Behaviors>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type domain:SceneDto}">
                                <Border BorderBrush="Transparent"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="20"
                                               HorizontalAlignment="Left"
                                               Padding="5 0 0 0"
                                               TextAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Grid.Row="1">
                    <!-- TUTAJ JESZCZE NIE WIEM -->
                </Grid>
            </Grid>

            <Border Grid.Column="1"
                    BorderBrush="#000D14"
                    BorderThickness="3 0 0 0"
                    Background="Transparent">
                <!-- TUTAJ SCENE ITEMS ZE SCENY -->

                <TreeView Background="Transparent"
                          VerticalAlignment="Top"
                          BorderThickness="0"
                          HorizontalContentAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          VirtualizingStackPanel.ScrollUnit="Pixel">
                    <i:Interaction.Behaviors>
                        <behaviors:CollectionViewBehavior Source="{Binding TreeItems}"
                                                          RefreshTrigger="{Binding SceneItemsRefreshTrigger}" />
                        <behaviors:TreeViewSelectionBehavior SelectedItem="{Binding SelectedSceneItem, Mode=TwoWay}" />
                    </i:Interaction.Behaviors>

                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type items:SceneItemViewModel}">
                            <Grid>
                                <Border Background="{Binding BackgroundColor, Converter={StaticResource StringToBrushConverter}, Mode=OneWay}"
                                        Opacity="0.5" />
                                <TextBlock Text="{Binding SourceName}"
                                           Foreground="White"
                                           FontSize="20"
                                           MinWidth="200"
                                           HorizontalAlignment="Left"
                                           Padding="5 0 5 2" />
                            </Grid>
                        </HierarchicalDataTemplate>
                        
                        <HierarchicalDataTemplate DataType="{x:Type items:GroupItemViewModel}">
                            <Grid Margin="0 0 0 2">
                                <Border Background="Transparent" />
                                <TextBlock Text="{Binding SourceName}"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextAlignment="Justify"
                                           Padding="5 0 5 2" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding SubItems}">
                            <ContentPresenter Content="{Binding Content}"
                                              HorizontalAlignment="Stretch" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="ContextMenu"
                                    Value="{StaticResource SceneItemsContextMenu}" />
                            <Setter Property="Padding"
                                    Value="0" />
                            <Setter Property="BorderThickness"
                                    Value="0" />
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />

                            <Style.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                                 Color="#99e0ff"
                                                 Opacity="0.5" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                                 Color="Black" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                                 Color="#99e0ff"
                                                 Opacity="0.5"/>
                            </Style.Resources>
                            
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="Content"
                                                 Converter="{StaticResource TypeEqualsConverter}">
                                            <Binding.ConverterParameter>
                                                <x:Type TypeName="items:SceneItemViewModel" />
                                            </Binding.ConverterParameter>
                                        </Binding>
                                    </DataTrigger.Binding>

                                    <Setter Property="ContextMenu"
                                            Value="{StaticResource SceneItemsContextMenu}" />
                                </DataTrigger>

                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="Content"
                                                 Converter="{StaticResource TypeEqualsConverter}">
                                            <Binding.ConverterParameter>
                                                <x:Type TypeName="items:GroupItemViewModel" />
                                            </Binding.ConverterParameter>
                                        </Binding>
                                    </DataTrigger.Binding>

                                    <Setter Property="ContextMenu"
                                            Value="{StaticResource GroupItemContextMenu}" />
                                </DataTrigger>

                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>

                <!-- Trzeba zrobic nowa kolekcje zeby uwzglednia grupy takze przy kliknieciu na 
                scene w view trzeba generowac cale drzewo na bazie grup do nowej kolekcji -->

