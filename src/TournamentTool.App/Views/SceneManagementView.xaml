                                 Foreground="White"
                                 Content="None"
                                 HorizontalAlignment="Left"
                                 IsChecked="{Binding Tournament.DisplayedNameType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:DisplayedNameType.None}}" />
                    <RadioButton GroupName="DisplayedNames"
                                 Foreground="White"
                                 Content="Twitch"
                                 HorizontalAlignment="Left"
                                 IsChecked="{Binding Tournament.DisplayedNameType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:DisplayedNameType.Twitch}}" />
