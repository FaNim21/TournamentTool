                                 Content="Whitelist"
                                 HorizontalAlignment="Left"
                                 IsChecked="{Binding Tournament.DisplayedNameType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:DisplayedNameType.WhiteList}}" />
